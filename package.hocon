// A worked example with more than one dependency.
//
// Three packages are fetched here, and between them they are the three parts of a REPL: something to
// read a line with, something to run it against, and something to lay the answer out. None of the
// three knows the other two exist, which is the point -- what makes them a program is this file and
// `main.sysl`, and nothing else.
//
// The coordinates are identities rather than URLs, so they carry no `https://`, and each `version` is
// the tag `v<version>` on that repository. The coordinate names the *package*; the module a program
// imports is that package's own, which is why `sqlite3` is fetched and `sh.sysl.sqlite` is imported
// (`packages.md § 9` keeps the two deliberately apart).

package {
  name    = "sqlite-repl"
  version = "0.1.0"
}

dependencies {
  sqlite3   { git = "github.com/sysl-lang/sqlite3", version = "0.2.0" }
  linenoise { git = "github.com/sysl-lang/linenoise", version = "0.2.0" }
  table     { git = "github.com/sysl-lang/table", version = "0.1.3" }
}

// The union of what the three ask for, said again here because a program states its own needs rather
// than inheriting them silently: `os` for the database file, `posix` for the terminal linenoise puts
// into raw mode, and `alloc` because every row of every answer is storage whose size nobody knows
// until the query has run.
requires {
  os    = true
  posix = true
  alloc = true
}
